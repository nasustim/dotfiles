# Load alternative configuration; it applies its own directory-specific rules.
[include]
  path = ~/.config/git/config_alt

[credential]
  helper = osxkeychain
  helper = cache --timeout 30000

[fetch]
	prune = true

[color]
	status = auto
	branch = auto
	interactive = auto

[ghq]
  root = ~/ghq
